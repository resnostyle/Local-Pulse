# Python ingestion service
FROM python:3.11-slim

WORKDIR /app

COPY python/requirements.txt .
RUN grep -v playwright requirements.txt > requirements-docker.txt && \
    pip install --no-cache-dir -r requirements-docker.txt

COPY python/ .

RUN test -f config/calendars.yaml || cp config/calendars.yaml.example config/calendars.yaml

RUN adduser --disabled-password --gecos "" appuser && \
    chown -R appuser:appuser /app
USER appuser

ENV LOCALPULSE_DATA_ROOT=/data

CMD ["python", "main.py", "run", "--force"]
